generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          Int          @id @default(autoincrement())
  name        String
  // URL identity. Backfilled from `name` by migration; stable after
  // that, so renaming a project does not break links that already
  // exist. Numeric ids still resolve via a 301 to the slug URL.
  slug        String       @unique
  description String
  url         String
  startDate   DateTime
  endDate     DateTime?
  // Multi-valued: a project can sit under more than one filter chip,
  // e.g. an open source tool that is also a development project.
  // A CHECK constraint keeps this from being empty.
  type        ProjectType[] @default([DEVELOP])
  featured    Boolean      @default(false)
  githubUrl   String?
  liveUrl     String?
  overview    String?
  excerpt     String?
  outcome     String? // Short delta shown in mono on the card: "2 days to 20 min"
  // Organizing body behind the work, same contract as Achievement.organizer.
  // Mainly for LEADERSHIP and OPEN_SOURCE rows, where the host org is part
  // of the story; null for personal projects.
  organizer   String?
  imageUrl    String?
  createdAt   DateTime     @default(now())
  ProjectTag  ProjectTag[]

  @@index([featured], map: "idx_project_featured")
  @@index([slug], map: "idx_project_slug")
  @@index([type], map: "idx_project_type")
}

model BlogPost {
  id          Int           @id @default(autoincrement())
  title       String
  slug        String        @unique
  excerpt     String
  content     String
  coverImage  String?
  tags        String[]
  published   Boolean       @default(false)
  readTime    Int?
  publishedAt DateTime?     @default(now()) @db.Timestamptz(6)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  BlogPostTag BlogPostTag[]

  @@index([published], map: "idx_blogpost_published")
  @@index([slug], map: "idx_blogpost_slug")
}

model Achievement {
  id             Int              @id(map: "Competition_pkey") @default(autoincrement())
  name           String
  // URL identity, same contract as Project.slug.
  slug           String           @unique
  type           String
  description    String
  content        String?
  result         String
  organizer      String?
  url            String? // Legacy: single link, kept for backward compatibility. New content should use `links`.
  links          Json? // Up to 3 labeled links: [{ "label": "Certificate", "url": "https://..." }, ...]
  // Card cover, same contract as Project.imageUrl. Path convention:
  // /achievements/<slug>/cover.<ext>. Without it the card falls back to
  // scraping the first image out of `content`, then to typography.
  imageUrl       String?
  tags           String[]
  date           DateTime
  featured       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  AchievementTag AchievementTag[]

  @@index([date], map: "idx_achievement_date")
  @@index([featured], map: "idx_achievement_featured")
  @@index([slug], map: "idx_achievement_slug")
}

model AchievementTag {
  achievementId Int
  tagId         Int
  Achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([achievementId, tagId])
  @@index([achievementId], map: "idx_achievement_tag_achievement")
  @@index([tagId], map: "idx_achievement_tag_tag")
}

model BlogPostTag {
  blogPostId Int
  tagId      Int
  BlogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([blogPostId, tagId])
  @@index([blogPostId], map: "idx_blogpost_tag_blogpost")
  @@index([tagId], map: "idx_blogpost_tag_tag")
}

model ProjectTag {
  projectId Int
  tagId     Int
  Project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([projectId, tagId])
  @@index([projectId], map: "idx_project_tag_project")
  @@index([tagId], map: "idx_project_tag_tag")
}

model Tag {
  id             Int              @id @default(autoincrement())
  name           String           @unique
  slug           String           @unique
  type           TagType
  description    String?
  color          String?
  createdAt      DateTime         @default(now())
  AchievementTag AchievementTag[]
  BlogPostTag    BlogPostTag[]
  ProjectTag     ProjectTag[]

  @@index([slug], map: "idx_tag_slug")
  @@index([type], map: "idx_tag_type")
}

model OpenSourceContribution {
  id           Int      @id @default(autoincrement())
  projectName  String
  organization String?
  description  String
  prUrl        String?
  repoUrl      String?
  liveUrl      String?
  merged       Boolean  @default(false)
  featured     Boolean  @default(false)
  // Card cover for the grouped project card. Path convention:
  // /open-source/<slug>/cover.<ext>. Rows are grouped by projectName,
  // so the first non-null value in a group wins.
  imageUrl     String?
  date         DateTime
  createdAt    DateTime @default(now())

  @@index([date], map: "idx_oss_date")
  @@index([featured], map: "idx_oss_featured")
}

// Mirrors WorkCategory in lib/database.ts, which drives the home-page
// filter rail. Keep the two in sync: a value here with no counterpart
// there is a category no chip can select.
enum ProjectType {
  DEVELOP
  OPEN_SOURCE
  DESIGN
  LEADERSHIP
}

enum TagType {
  TECHNICAL
  NON_TECHNICAL
}

// Resume tracking (Phase 1.2): no auth wall, full visibility into where
// resume views come from. RLS: enable on both tables with no anonymous
// policies (deny-all); server routes use SUPABASE_SERVICE_ROLE_KEY.
model ResumeLink {
  id        Int            @id @default(autoincrement())
  slug      String         @unique // "linkedin", "github", "stripe-2026"
  label     String // "LinkedIn profile", "Stripe application Aug 2026"
  kind      ResumeLinkKind @default(CHANNEL)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  accesses  ResumeAccess[]
}

model ResumeAccess {
  id         Int         @id @default(autoincrement())
  linkId     Int?
  link       ResumeLink? @relation(fields: [linkId], references: [id])
  src        String? // raw ?src= value when no ResumeLink matches
  referrer   String?
  country    String?
  city       String?
  userAgent  String?
  ipHash     String? // sha256(ip + RESUME_SALT), never the raw IP
  emailedTo  String?
  accessedAt DateTime    @default(now())

  @@index([linkId, accessedAt])
}

enum ResumeLinkKind {
  CHANNEL
  APPLICATION
}

// Untangle-knot completions (Phase 2.5): anonymous solve durations.
// RLS deny-all for anon; inserts go through the service role.
model UntangleSolve {
  id         Int      @id @default(autoincrement())
  durationMs Int
  createdAt  DateTime @default(now())
}
